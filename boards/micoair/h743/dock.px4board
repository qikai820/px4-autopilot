# DockGuidance / Viztra additions for this target.
CONFIG_MAVLINK_DIALECT="viztra"
CONFIG_BOARD_EMBEDDED_METADATA=y
CONFIG_BOARD_ADDITIONAL_INIT="rc.dock_defaults"
CONFIG_DRIVERS_VIZTRA=y
CONFIG_DRIVERS_ENCODER_MT6701=y
CONFIG_MODULES_DOCK_GUIDANCE=y
# Valid Viztra tracking enters DockGuidance's matrix estimator on this queue.
CONFIG_WQ_NAV_AND_CONTROLLERS_STACKSIZE=4096
