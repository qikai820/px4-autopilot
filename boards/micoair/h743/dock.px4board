CONFIG_DRIVERS_GPS=y
CONFIG_COMMON_HYGROMETERS=n
CONFIG_DRIVERS_IMU_BOSCH_BMI088=y
CONFIG_DRIVERS_IMU_BOSCH_BMI270=y
CONFIG_COMMON_MAGNETOMETER=y
CONFIG_COMMON_OPTICAL_FLOW=n
CONFIG_DRIVERS_OSD_MSP_OSD=y
CONFIG_DRIVERS_POWER_MONITOR_INA220=n
CONFIG_DRIVERS_POWER_MONITOR_INA226=n
CONFIG_DRIVERS_POWER_MONITOR_INA228=n
CONFIG_DRIVERS_POWER_MONITOR_INA238=n
CONFIG_DRIVERS_POWER_MONITOR_PM_SELECTOR_AUTERION=n
CONFIG_DRIVERS_POWER_MONITOR_VOXLPM=n
CONFIG_DRIVERS_PPS_CAPTURE=n
CONFIG_DRIVERS_PWM_OUT=y
CONFIG_COMMON_RC=y
CONFIG_DRIVERS_RC_INPUT=y
CONFIG_COMMON_RPM=n
CONFIG_DRIVERS_SMART_BATTERY_BATMON=n
CONFIG_DRIVERS_TAP_ESC=n
