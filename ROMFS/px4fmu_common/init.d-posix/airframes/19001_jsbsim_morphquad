#!/bin/sh
#
# @name MorphQuad SITL model for JSBSim
#
# @type MorphQuad
# @class Copter
#
# MorphQuad: a quadrotor with independently tilting rotors via
# dual-axis gimbal servos. Each rotor can point thrust in an
# arbitrary direction, making it a fully-actuated 6DOF system.
#
# Actuator mapping (interleaved per-motor, matching PX4 actuator_sp):
#   Motors 0-3:  rotor speeds (Omega_0 .. Omega_3)
#   Servos 4-11: per-motor interleaved gimbal servos:
#                alpha_0, beta_0, alpha_1, beta_1, alpha_2, beta_2, alpha_3, beta_3
#
# Control allocation is handled by ActuatorEffectivenessMorphQuad
# using Pattern B (custom updateSetpoint override).
#

. ${R}etc/init.d/rc.vector_defaults

# --- Airframe type: MorphQuad (CA_AIRFRAME = 16) ---
param set-default CA_AIRFRAME 16

# --- MorphQuad geometry (matches JSBSim morphquad.xml) ---
param set-default CA_MQ_L 0.25
param set-default CA_MQ_B 0.20
param set-default CA_MQ_TMAX 27.5

# --- PWM output channel mapping ---
# Motors: channels 1-4
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
# ── Servo (gimbal) channel mapping (interleaved α/β per motor) ──
# Output channel order matches PX4 actuator_sp layout:
#   [4]=α0, [5]=β0, [6]=α1, [7]=β1, [8]=α2, [9]=β2, [10]=α3, [11]=β3
# The JSBSim bridge config morphquad.xml must use the SAME interleaved indexing.
param set-default PWM_MAIN_FUNC5 201
param set-default PWM_MAIN_FUNC6 202
param set-default PWM_MAIN_FUNC7 203
param set-default PWM_MAIN_FUNC8 204
param set-default PWM_MAIN_FUNC9 205
param set-default PWM_MAIN_FUNC10 206
param set-default PWM_MAIN_FUNC11 207
param set-default PWM_MAIN_FUNC12 208
