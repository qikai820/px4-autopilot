#!/bin/sh
# MorphQuad and Voliro T: complete MC-derived control chain.
# Fail boot instead of starting a second wrench publisher.
if mc_pos_control status
then
 echo "ERROR: mc_pos_control already running"
 exit 1
fi
if mc_att_control status
then
 echo "ERROR: mc_att_control already running"
 exit 1
fi
if mc_rate_control status
then
 echo "ERROR: mc_rate_control already running"
 exit 1
fi
control_allocator start
flight_mode_manager start
vector_rate_control start
vector_att_control start
vector_pos_control start
land_detector start multicopter
