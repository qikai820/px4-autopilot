#!/bin/sh
#
# @name MorphQuad - Morphable Quadrotor
#
# @type MorphQuad
# @class Copter
#
# MorphQuad: a quadrotor with independently tilting rotors via
# dual-axis gimbal servos. Each rotor can point thrust in an
# arbitrary direction, making it a fully-actuated 6DOF system.
#
# Actuator mapping:
#   Motors 0-3:  rotor speeds (Omega_0 .. Omega_3)
#   Servos 0-7:  per-motor interleaved gimbal servos:
#               alpha_0, beta_0, alpha_1, beta_1, alpha_2, beta_2, alpha_3, beta_3
#               (outer alpha_i at actuator_sp[4+2i], inner beta_i at actuator_sp[5+2i])
#
# Control allocation is handled by ActuatorEffectivenessMorphQuad
# using Pattern B (custom updateSetpoint override).
#

. ${R}etc/init.d/rc.vector_defaults

# --- Airframe type: MorphQuad (CA_AIRFRAME = 16) ---
param set-default CA_AIRFRAME 16

# --- Control allocation method: Pseudo-inverse ---
param set-default CA_METHOD 0

# --- Enable geo_control module ---
param set-default SYS_HAS_MC 1
param set-default GC_HOVER_THR 0.35
param set-default GC_Z_VEL_P 2.0

# --- GeoControl manual Position-mode limits ---
param set-default GC_VX_MAX 2.0
param set-default GC_VY_MAX 2.0
param set-default GC_VZ_MAX 1.0
param set-default GC_AX_MAX 2.0
param set-default GC_AY_MAX 2.0
param set-default GC_AZ_MAX 1.0
param set-default GC_ROLL_MAX 20.0
param set-default GC_PITCH_MAX 20.0

# --- Split geometric controller defaults ---
param set-default GPC_RATE_HZ 50.0
param set-default GPC_MASS 4.56
param set-default GPC_HOV_THR 0.35
param set-default GPC_THR_MAX 158.0
param set-default GPC_Z_VP 2.0
param set-default GPC_VX_MAX 2.0
param set-default GPC_VY_MAX 2.0
param set-default GPC_VZ_MAX 1.0
param set-default GPC_AX_MAX 2.0
param set-default GPC_AY_MAX 2.0
param set-default GPC_AZ_MAX 1.0
param set-default GPC_ROLL_MAX 20.0
param set-default GPC_PITCH_MAX 20.0
param set-default GAC_RATE_HZ 400.0
param set-default GAC_ROLL_MAX 20.0
param set-default GAC_PITCH_MAX 20.0
param set-default GAC_IXX 0.1
param set-default GAC_IYY 0.1
param set-default GAC_IZZ 0.2

# --- PWM output channel mapping ---
# Motors: channels 1-4
param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104
# ── Servo (gimbal) channel mapping ──
# 舵机按"先外后内、逐电机"交错编号, 与 ActuatorEffectivenessMorphQuad 一致。
# 函数号 201..208 依次对应 actuator_sp[4..11], 因此物理通道顺序即为交错布局:
#   PWM channel  5 (FUNC 201) = 电机0 外舵机 α0  (actuator_sp[4])
#   PWM channel  6 (FUNC 202) = 电机0 内舵机 β0  (actuator_sp[5])
#   PWM channel  7 (FUNC 203) = 电机1 外舵机 α1  (actuator_sp[6])
#   PWM channel  8 (FUNC 204) = 电机1 内舵机 β1  (actuator_sp[7])
#   PWM channel  9 (FUNC 205) = 电机2 外舵机 α2  (actuator_sp[8])
#   PWM channel 10 (FUNC 206) = 电机2 内舵机 β2  (actuator_sp[9])
#   PWM channel 11 (FUNC 207) = 电机3 外舵机 α3  (actuator_sp[10])
#   PWM channel 12 (FUNC 208) = 电机3 内舵机 β3  (actuator_sp[11])
# 注意: 物理舵机接线需按此顺序(α0,β0,α1,β1,α2,β2,α3,β3)连接 PWM 5-12。
param set-default PWM_MAIN_FUNC5 201
param set-default PWM_MAIN_FUNC6 202
param set-default PWM_MAIN_FUNC7 203
param set-default PWM_MAIN_FUNC8 204
param set-default PWM_MAIN_FUNC9 205
param set-default PWM_MAIN_FUNC10 206
param set-default PWM_MAIN_FUNC11 207
param set-default PWM_MAIN_FUNC12 208
