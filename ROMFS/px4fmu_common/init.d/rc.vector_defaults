#!/bin/sh
#
# MorphQuad (vector-thrust) default parameters.
#
# NOTE: Script variables are declared/initialized/unset in the rcS script.
#

set VEHICLE_TYPE vector

# MAV_TYPE_GENERIC = 0, use generic multicopter type for GCS compatibility
param set-default MAV_TYPE 2

# --- Vehicle physical parameters ---

# --- Position control gains ---

# --- Attitude control gains ---

# --- Navigation / safety defaults (inherit from MC) ---
param set-default NAV_ACC_RAD 2
param set-default RTL_RETURN_ALT 30
param set-default RTL_DESCEND_ALT 10

# The complete task layer uses the standard MPC_* navigation constraints.
# Vector control gains use VPC_* and VC_*; both allocators use normalized wrench topics.
param set-default MPC_USE_HTE 0

# Preserve the existing vector HIL link configuration.
# POSIX SITL uses simulator_mavlink and its private UDP link instead.
if [ -z "$PX4_SIM_MODEL" ]
then
 ifconfig eth0 192.168.3.10
 mavlink start -u 14561 -o 14560 -p -r 4000000 -m onboard
fi
