menuconfig MODULES_VECTOR_RATE_CONTROL
	bool "vector_rate_control"
	default n
	---help---
		Enable support for vector_rate_control

menuconfig USER_VECTOR_RATE_CONTROL
	bool "vector_rate_control running as userspace module"
	default n
	depends on BOARD_PROTECTED && MODULES_VECTOR_RATE_CONTROL
	---help---
		Put vector_rate_control in userspace memory
