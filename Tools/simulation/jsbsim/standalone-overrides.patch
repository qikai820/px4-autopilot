+#!/usr/bin/env bash
+# Software-only counterpart of run.sh; physical FC configuration is not changed.
+set -euo pipefail
+project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
+export JSBSIM_ROOT="$project_root"
+px4_root="${PX4_ROOT:-$project_root/../PX4-Autopilot}"
+exec "$px4_root/Tools/simulation/jsbsim/run_vector_sitl.sh" "$@"
