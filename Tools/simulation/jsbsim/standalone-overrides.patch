 //   server → bridge:  传感器数据 (SensorFrame)
 
 static constexpr uint16_t kDefaultServerPort = 5800;
+
+// An inherited process-local override keeps independent bridge/server pairs isolated.
+inline uint16_t configuredServerPort() {
+    const char *value = std::getenv("JSBSIM_SERVER_PORT");
+    if (!value || !*value) return kDefaultServerPort;
+    char *end = nullptr;
+    errno = 0;
+    const auto port = std::strtoul(value, &end, 10);
+    if (errno || *end || port == 0 || port > 65535)
+        throw std::invalid_argument("JSBSIM_SERVER_PORT must be in 1..65535");
+    return static_cast<uint16_t>(port);
+}
+
